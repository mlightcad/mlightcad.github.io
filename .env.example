# Frontend: point at the Paddle environment you are testing.
# Use sandbox values locally; GitHub Actions / production build should use live values.
VITE_PADDLE_ENV=sandbox
VITE_PADDLE_CLIENT_TOKEN=test_your_client_side_token
VITE_PADDLE_PRICE_PERPETUAL=pri_01m0s5c4d44zz3de9d9jf7aa6h
VITE_PADDLE_PRICE_ANNUAL=pri_01m0s6fj6948whh096zzhndv5k

# Optional browser Supabase client (publishable key: sb_publishable_…).
# Needed again when re-enabling the in-page trial form (`src/trial-license.ts`).
# Prefer a *sandbox* Supabase project URL here during local work.
# Dashboard → Settings → API Keys → Publishable and secret API keys.
# VITE_SUPABASE_URL=https://YOUR_SANDBOX_PROJECT_REF.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_…

# Never put Paddle API keys or webhook secrets in VITE_*.
# Put them in each Supabase project's Edge Function secrets:
#   PADDLE_API_KEY, PADDLE_WEBHOOK_SECRET, PADDLE_ENV,
#   PADDLE_PRICE_PERPETUAL, PADDLE_PRICE_ANNUAL
# Use one Supabase project for Paddle sandbox and another for Paddle live.
