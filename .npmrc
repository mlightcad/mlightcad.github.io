# Public @mlightcad/* packages come from npmjs.
# Do NOT set @mlightcad:registry to GitHub Packages — that would break public packages.
# Private @mlightcad/dwg-converter is resolved via its lockfile tarball URL on
# npm.pkg.github.com (install once with --registry https://npm.pkg.github.com).
registry=https://registry.npmjs.org/
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
